# Second Brain — Local Environment Configuration Example
#
# Copy this file to .env (which is gitignored) and customize for your machine:
#   cp .env.example .env
#
# NEVER commit a populated .env file or real API keys / tokens.

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432

# Primary connection string used by bridge.py, pipeline/, retrieval/, scripts/
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/secondbrain

# Optional: dedicated throwaway test database (dbname MUST contain a delimited
# "test" token, e.g. secondbrain_test, or test suites will refuse to run).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/secondbrain_test

# -----------------------------------------------------------------------------
# Dropbox Web UI (dropbox/server.js)
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
PYTHON=python
BRIDGE_TIMEOUT_MS=180000
# Set to 1 ONLY if you intentionally bind HOST to a non-loopback address:
# ALLOW_NONLOCAL_HOST=1

# -----------------------------------------------------------------------------
# MCP Server (mcp-server/) — Phase 5 Least-Privilege Scopes
# -----------------------------------------------------------------------------
# Recommended: always set explicitly.
#   read  = read-only 6 tools (safe for untrusted coding agents)
#   write = all 12 tools (requires SECONDBRAIN_WRITE_TOKEN; trusted agents only)
SECONDBRAIN_MCP_SCOPE=read
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECONDBRAIN_WRITE_TOKEN=
MCP_CALL_TIMEOUT_MS=120000
# Optional overrides for runtime artifacts (defaults live at repo root):
# SECONDBRAIN_AUDIT_LOG=./audit_log.jsonl
# SECONDBRAIN_FLAG_QUEUE=./flagged_issues.json
# SECONDBRAIN_ACTOR=local

# -----------------------------------------------------------------------------
# Optional: LLM Entity/Relation Extraction & Vision (OpenAI-compatible APIs)
# -----------------------------------------------------------------------------
# Leave EXTRACT_ENABLED unset or 0 for 100% local/offline ingestion.
# EXTRACT_ENABLED=1
# EXTRACT_API_URL=http://127.0.0.1:11434/v1/chat/completions
# EXTRACT_MODEL=llama3.1:8b
# EXTRACT_API_KEY=

# Optional Vision LLM for image/screenshot descriptions (falls back to OCR):
# VISION_API_URL=http://127.0.0.1:11434/v1/chat/completions
# VISION_MODEL=qwen2.5-vl
# VISION_API_KEY=

# External-send approval gate (Phase 5): when set to 1, non-loopback POSTs from
# EXTRACT_API_URL / VISION_API_URL are blocked unless the host is allowlisted.
SECONDBRAIN_REQUIRE_EXTERNAL_APPROVAL=1
# Comma-separated hostnames (or host:port) approved for outbound LLM/Vision calls:
# SECONDBRAIN_EXTERNAL_ALLOWLIST=api.openai.com

# Optional GitHub token for higher rate limits / private repo imports:
# GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Local Notes, Backups & File Ingestion
# -----------------------------------------------------------------------------
# NOTES_DIR=./notes
# BACKUP_SOURCE_URL=postgresql://postgres:postgres@127.0.0.1:5432/secondbrain
# BACKUP_DIR=./backups
# Optional extra directories (colon/semicolon-separated) allowed by bridge.py:
# BRIDGE_PATH_ALLOWLIST=
